---
// Dark top bar, like the D365 F&O navigation bar: menu toggle (mobile),
// site name, search and icon links.
import { site } from "../site.config";
---

<header class="navbar">
  <button
    class="navbar__menu"
    type="button"
    aria-label="Navigation menu"
    aria-expanded="false"
    aria-controls="navpane"
    data-navpane-toggle
  >
    <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true">
      <path
        d="M3 5h14M3 10h14M3 15h14"
        stroke="currentColor"
        stroke-width="1.5"
      />
    </svg>
  </button>

  <a class="navbar__brand" href="/">
    {site.name}
  </a>

  <!-- Stub: Pagefind search arrives later. -->
  <button class="navbar__search" type="button">
    <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true">
      <circle
        cx="8.5"
        cy="8.5"
        r="5.5"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
      />
      <path d="M12.5 12.5 17 17" stroke="currentColor" stroke-width="1.5" />
    </svg>
    <span>Search</span>
  </button>

  <div class="navbar__icons">
    <!-- Stub: the RSS feed arrives in phase 3. -->
    <button class="navbar__icon" type="button" aria-label="RSS feed">
      <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
        <circle cx="5" cy="15" r="1.75" fill="currentColor" />
        <path
          d="M3.5 9.5a7 7 0 0 1 7 7M3.5 4a12.5 12.5 0 0 1 12.5 12.5"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
        />
      </svg>
    </button>
    <a
      class="navbar__icon"
      href={site.repoUrl}
      aria-label="Source code on GitHub"
    >
      <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true">
        <path
          fill="currentColor"
          d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
        ></path>
      </svg>
    </a>
  </div>
</header>

<script>
  // Mobile only: show/hide the navigation pane. On wide screens the pane is
  // always visible and the menu button is hidden by CSS.
  const toggle = document.querySelector<HTMLButtonElement>(
    "[data-navpane-toggle]",
  );
  const pane = document.getElementById("navpane");
  toggle?.addEventListener("click", () => {
    const open = toggle.getAttribute("aria-expanded") === "true";
    toggle.setAttribute("aria-expanded", String(!open));
    pane?.classList.toggle("is-open", !open);
  });
</script>

<style>
  .navbar {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    height: 48px;
    padding: 0 var(--space-2);
    background: var(--color-navbar);
    color: var(--color-text-on-dark);
  }

  .navbar button,
  .navbar a {
    color: inherit;
  }

  .navbar__menu,
  .navbar__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--touch-target);
    height: var(--touch-target);
    padding: 0;
    background: transparent;
    border: 0;
    border-radius: var(--radius-medium);
  }

  .navbar__menu:hover,
  .navbar__icon:hover {
    background: rgb(255 255 255 / 0.12);
  }

  .navbar__brand {
    font-size: var(--font-size-200);
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }

  .navbar__brand:hover {
    color: inherit;
    text-decoration: underline;
  }

  .navbar__search {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex: 0 1 320px;
    margin-left: auto;
    padding: 0 var(--space-3);
    font-size: var(--font-size-200);
    text-align: left;
    background: rgb(255 255 255 / 0.1);
    border: var(--border-width) solid rgb(255 255 255 / 0.3);
    border-radius: var(--radius-medium);
  }

  .navbar__icons {
    display: flex;
  }

  /* Light focus ring: the default accent ring is invisible on navy. */
  .navbar :focus-visible {
    outline-color: var(--color-text-on-dark);
  }

  @media (min-width: 768px) {
    .navbar__menu {
      display: none;
    }

    .navbar {
      padding-left: var(--space-4);
    }
  }

  @media (max-width: 479px) {
    /* Narrow phones: keep only the icon so the brand fits. */
    .navbar__search {
      flex: 0 0 var(--touch-target);
      justify-content: center;
      padding: 0;
    }

    .navbar__search span {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
    }
  }
</style>
