{
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "[astro]": { "editor.defaultFormatter": "astro-build.astro-vscode" },
  "files.associations": { "*.xpp": "csharp" },
  "cssVariables.lookupFiles": ["src/styles/**/*.css"],
  "markdownlint.config": {
    "MD013": false,
    "MD033": false
  },
  "cSpell.words": ["Axum", "Bazzite", "distrobox", "Dynamics", "Fluent", "Obsidian", "wikilinks", "Xpp"]
}
